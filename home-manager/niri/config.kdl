// =========================================================================
// niri config
// =========================================================================

// -------------------------------------------------------------------------
// Startup / session
// -------------------------------------------------------------------------
spawn-at-startup "noctalia"
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// -------------------------------------------------------------------------
// Environment
// -------------------------------------------------------------------------
environment {
    NIXOS_OZONE_WL "1"
}

// -------------------------------------------------------------------------
// Output
// -------------------------------------------------------------------------
output "eDP-1" {
    mode "1920x1200@59.999"
    scale 1.25
    transform "normal"
    position x=0 y=0
}

// -------------------------------------------------------------------------
// Input
// -------------------------------------------------------------------------
input {
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="33%"

    keyboard {
        xkb {
            layout "br,us"
            variant "abnt2,"
            options "compose:ralt"
        }
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.5
    }

    mouse {
        natural-scroll
    }
}

// -------------------------------------------------------------------------
// Appearance
// -------------------------------------------------------------------------

// -- Cursor --
cursor {
    xcursor-theme "Cartoonish-Bold"
    xcursor-size 24
}

// -- Layout (gaps / focus-ring / border) --
layout {
    focus-ring {
        width 3
    }
    border {
        width 0
    }
    gaps 6

    center-focused-column "never"
}

// -- Gestures --
gestures {
    hot-corners {
        top-left
    }
}

// -- Animations --
animations {
    window-open { curve "cubic-bezier" 0.17 0.67 0.83 0.67; }
    window-close { curve "cubic-bezier" 0.17 0.67 0.83 0.67; }
    window-movement { curve "cubic-bezier" 0.17 0.67 0.83 0.67; }
    window-resize { curve "cubic-bezier" 0.17 0.67 0.83 0.67; }
    overview-open-close { curve "cubic-bezier" 0.17 0.67 0.83 0.67; }
}

// -- Blur --
blur {
    passes 2
    offset 2.0000000000000004
    noise 0.0
    saturation 1.0
}

// -------------------------------------------------------------------------
// Window rules
// -------------------------------------------------------------------------

// Blur behind the focused window
window-rule {
    match is-focused=true
    background-effect {
        blur true
    }
}

// Global look: rounded corners + blur on every window
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

// Per-app default column width
window-rule { match app-id=r"kitty"; default-column-width { proportion 0.33333; }; }
window-rule { match app-id=r"zen-twilight"; default-column-width { proportion 1.0; }; }
window-rule { match app-id=r"codium"; default-column-width { proportion 1.0; }; }

// -------------------------------------------------------------------------
// Layer rules
// -------------------------------------------------------------------------
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
    background-effect {
        xray false
    }
}

// -------------------------------------------------------------------------
// Keybindings
// -------------------------------------------------------------------------
binds {

    // -- Applications --
    Mod+Return repeat=false { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+B repeat=false { spawn "zen-twilight"; }
    Mod+apostrophe repeat=false { spawn "sh" "-c" "kitty --directory \"$HOME/nix\""; }
    Mod+X repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }

    // Fuzzel project picker: lists ~/Projects plus ~/nix, opens the pick in codium
    Mod+P repeat=false { spawn "sh" "-c" "projects=\"$HOME/Projects\"; codium=\"$HOME/.local/share/vscode-vibrancy/current/bin/codium\"; sel=$( (find \"$projects\" -mindepth 1 -maxdepth 1 -type d -printf '%f\\n'; printf 'nix\\n') | sort | fuzzel --dmenu --prompt 'Projeto: '); [ -n \"$sel\" ] || exit 0; [ \"$sel\" = nix ] && path=\"$HOME/nix\" || path=\"$projects/$sel\"; \"$codium\" \"$path\""; }

    // -- Window management --
    Mod+Q { close-window; }
    Mod+space { maximize-column; }
    Mod+Alt+space { fullscreen-window; }

    Mod+left { focus-column-left; }
    Mod+right { focus-column-right; }
    Mod+up { focus-window-up; }
    Mod+down { focus-window-down; }

    Mod+Alt+left { move-column-left; }
    Mod+Alt+right { move-column-right; }
    Mod+Alt+up { move-window-up; }
    Mod+Alt+down { move-window-down; }

    // -- Workspaces --
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // -- Screenshots --
    Mod+Y { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Shift+Y { spawn "sh" "-c" "file=\"$HOME/Pictures/Screenshots/Screenshot from $(date +%Y-%m-%d_%H-%M-%S).png\"; grim -g \"$(slurp)\" - | tee \"$file\" | wl-copy"; }
    Mod+Alt+Y { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty -f - --copy-command wl-copy --actions-on-enter=save-to-clipboard,exit"; }
    Mod+Shift+Alt+Y { spawn "sh" "-c" "file=\"$HOME/Pictures/Screenshots/Screenshot from $(date +%Y-%m-%d_%H-%M-%S).png\"; grim -g \"$(slurp)\" - | satty -f - --copy-command wl-copy -o \"$file\" --actions-on-enter=save-to-clipboard,save-to-file,exit"; }
    Shift+Print { screenshot-screen; }
    Print { screenshot-window; }

    // -- Audio --
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // -- Brightness --
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-e4" "-n1" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n1" "set" "5%-"; }

    // -- Session --
    Mod+Shift+E { quit; }
}

// -------------------------------------------------------------------------
// External includes
// -------------------------------------------------------------------------
include "noctalia.kdl"
